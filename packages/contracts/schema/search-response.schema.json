{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.jobinfo.local/v1/search-response.schema.json",
  "title": "SearchResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "success", "code", "query", "contents", "partialFailures"],
  "properties": {
    "ok": {"const": true},
    "success": {"const": true},
    "code": {"const": "ok"},
    "query": {"type": "string"},
    "contents": {"type": "array", "items": {"$ref": "content.schema.json"}},
    "partialFailures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "reason"],
        "properties": {
          "sourceId": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
