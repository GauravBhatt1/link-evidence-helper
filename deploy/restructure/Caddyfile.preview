{
	auto_https off
	admin off
	persist_config off
	log {
		output stdout
		format json
		level INFO
	}
}

http://127.0.0.1:18880 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
	}

	@health path /livez /readyz
	handle @health {
		reverse_proxy api:8780 {
			health_uri /livez
			health_interval 15s
			health_timeout 3s
			transport http {
				dial_timeout 3s
				response_header_timeout 5s
			}
		}
	}

	handle {
		reverse_proxy api:8780 {
			transport http {
				dial_timeout 3s
				response_header_timeout 30s
			}
		}
	}

	log {
		output stdout
		format json
	}
}
