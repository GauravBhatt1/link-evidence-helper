{
	admin off
	auto_https off
}

:8080 {
	log {
		output stdout
		format json
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cache-Control "no-store"
	}

	@unsafe_methods method TRACE CONNECT
	respond @unsafe_methods 405

	handle /api/* {
		reverse_proxy api:8780 {
			health_uri /healthz
			health_interval 10s
			health_timeout 3s
			lb_try_duration 2s
			lb_try_interval 250ms
		}
	}

	handle /healthz {
		reverse_proxy api:8780 {
			health_uri /healthz
			health_interval 10s
			health_timeout 3s
			lb_try_duration 2s
			lb_try_interval 250ms
		}
	}

	handle {
		root * /srv/link-evidence-web
		try_files {path} /index.html
		file_server
	}
}
