# syntax=docker/dockerfile:1.7
FROM golang:1.23.12-alpine AS build
WORKDIR /src
COPY apps/api/go.mod apps/api/go.sum ./apps/api/
COPY packages/jobqueue/go.mod packages/jobqueue/go.sum ./packages/jobqueue/
RUN --mount=type=cache,target=/go/pkg/mod cd apps/api && go mod download
COPY apps/api ./apps/api
COPY packages/jobqueue ./packages/jobqueue
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    cd apps/api && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/link-evidence-api ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/link-evidence-api /usr/local/bin/link-evidence-api
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/link-evidence-api"]
