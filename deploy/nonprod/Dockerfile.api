# syntax=docker/dockerfile:1.7
FROM golang:1.23.12-alpine AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    cd apps/api && go mod download && \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/link-evidence-api ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/link-evidence-api /usr/local/bin/link-evidence-api
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/link-evidence-api"]
